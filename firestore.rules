rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isGordonCollegeUser() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@gordoncollege\\.edu\\.ph$');
    }

    match /users/{userId} {
      allow read, write: if isGordonCollegeUser()
        && request.auth.uid == userId;
    }

    match /rooms/{roomId} {
      allow read, write: if isGordonCollegeUser();
    }
  }
}
